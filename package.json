{
	"name": "archived-post-status",
	"version": "0.4.0",
	"description": "A plugin gives you the power to archive your WordPress content.",
	"author": "Joshua David Nelson <josh@joshuadnelson.com>",
	"license": "GPL-2.0-or-later",
	"homepage": "https://archivedpoststat.us/",
	"repository": {
		"type": "git",
		"url": "git@github.com:joshuadavidnelson/archived-post-status.git"
	},
	"scripts": {
		"cypress:open": "./tests/bin/initialize.sh && cypress open --config-file=tests/cypress/config.config.js --e2e --browser chrome",
		"cypress:run": "./tests/bin/initialize.sh && cypress run --config-file=tests/cypress/config.config.js",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:shell": "wp-env run cli /bin/bash",
		"test": "jest --verbose --runInBand --detectOpenHandles --forceExit",
		"test:watch": "jest --watch",
		"postenv:start": "./tests/bin/initialize.sh",
		"test:coverage": "jest --coverage"
	},
	"devDependencies": {
		"@10up/cypress-wp-utils": "github:10up/cypress-wp-utils#build",
		"@babel/core": "^7.23.9",
		"@babel/preset-env": "^7.28.3",
		"@babel/preset-react": "^7.23.3",
		"@types/node": "^18.0.0",
		"@wordpress/env": "^10.31.0",
		"@wordpress/scripts": "^30.24.0",
		"babel-loader": "^9.1.3",
		"compare-versions": "^4.1.3",
		"cypress": "^14.0.1",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"jsdom": "^25.0.0"
	},
	"directories": {
		"test": "tests"
	}
}

{
	"name": "archived-post-status",
	"version": "0.3.11",
	"description": "A WordPress plugin that allows posts and pages to be archived so you can unpublish content without having to trash it.",
	"author": "Joshua David Nelson",
	"license": "GPL-2.0-or-later",
	"homepage": "https://archivedpoststat.us/",
	"repository": {
		"type": "git",
		"url": "git@github.com:joshuadavidnelson/archived-post-status.git"
	},
	"scripts": {
		"cypress:open": "./tests/bin/initialize.sh && cypress open --config-file=tests/cypress/config.config.js --e2e --browser chrome",
		"cypress:run": "./tests/bin/initialize.sh && cypress run --config-file=tests/cypress/config.config.js",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"postenv:start": "./tests/bin/initialize.sh"
	},
	"directories": {
		"test": "tests"
	},
	"devDependencies": {
		"@10up/cypress-wp-utils": "github:10up/cypress-wp-utils#build",
		"@types/node": "^18.0.0",
		"@wordpress/env": "^5.0.0",
		"@wordpress/scripts": "^26.19.0",
		"compare-versions": "^4.1.3",
		"cypress": "^14.0.1"
	}
}

{
  "name": "joshuadavidnelson/archived-post-status",
  "version": "0.4.0",
  "type": "wordpress-plugin",
  "description": "A WordPress plugin that allows posts and pages to be archived so you can unpublish content without having to trash it.",
  "homepage": "https://archivedpoststat.us/",
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "https://github.com/joshuadavidnelson/archived-post-status/issues",
    "docs": "https://docs.archivedpoststat.us/",
    "forum": "https://wordpress.org/support/plugin/archived-post-status/"
  },
  "authors": [
		{
			"name": "Joshua David Nelson",
			"email": "josh@joshuadnelson.com"
		},
    {
      "name": "Frankie Jarrett",
      "email": "fjarrett@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.0"
  },
  "scripts": {
    "test": [
      "./vendor/bin/phpunit"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=2048M"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "lint": [
      "find *.php src/ tests/ -type f -name '*.php' -print0 | xargs -0 -L1 -P4 -- php -l"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5.24",
    "10up/wp_mock": "^0.5.0",
    "yoast/phpunit-polyfills": "^1.0",
    "squizlabs/php_codesniffer": "^3.11",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "automattic/vipwpcs": "^3.0",
    "doctrine/instantiator": "^1.5",
    "php-stubs/wordpress-stubs": "^6.9"
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}

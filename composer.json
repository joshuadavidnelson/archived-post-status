{
  "name": "joshuadavidnelson/archived-post-status",
  "version": "0.4.0",
  "type": "wordpress-plugin",
  "description": "This plugin gives you the power to archive your WordPress content.",
  "homepage": "https://archivedpoststat.us/",
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "https://github.com/joshuadavidnelson/archived-post-status/issues",
    "docs": "https://docs.archivedpoststat.us/",
    "forum": "https://wordpress.org/support/plugin/archived-post-status/"
  },
  "authors": [
		{
			"name": "Joshua David Nelson",
			"email": "josh@joshuadnelson.com"
		},
    {
      "name": "Frankie Jarrett",
      "email": "fjarrett@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.0"
  },
  "scripts": {
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=2048M"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "lint": [
      "./vendor/bin/parallel-lint *.php src/ tests/"
    ],
    "phpunit": [
      "./vendor/bin/phpunit"
    ],
    "phpunit:coverage": [
      "./vendor/bin/phpunit --coverage-text"
    ],
    "phpunit:coverage-html": [
      "./vendor/bin/phpunit --coverage-html coverage"
    ],
    "phpcbf": [
      "./vendor/bin/phpcbf"
    ],
    "phpmd": [
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmd src/ text phpmd.xml"
    ],
    "phpmetrics": [
      "./vendor/bin/phpmetrics --report-html=reports/metrics --report-json=reports/metrics.json src/"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5.24",
    "10up/wp_mock": "^0.5.0",
    "yoast/phpunit-polyfills": "^1.0",
    "squizlabs/php_codesniffer": "^3.11",
    "phpstan/phpstan": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "automattic/vipwpcs": "^3.0",
    "doctrine/instantiator": "^1.5",
    "php-stubs/wordpress-stubs": "^6.9",
    "johnbillion/wp-compat": "^1.4",
    "phpmd/phpmd": "^2.15",
    "phpmetrics/phpmetrics": "^2.8",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
